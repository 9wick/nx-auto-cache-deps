{
  "name": "nx-auto-cache-deps",
  "version": "0.0.6",
  "description": "File-access based command caching and automatic cache inputs for Nx",
  "license": "MIT",
  "type": "module",
  "main": "./dist/plugin.js",
  "bin": {
    "nx-auto-cache-deps": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/plugin.js",
    "./package.json": "./package.json"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "files": [
    "bin",
    "dist",
    "schemas",
    "executors.json",
    "generators.json",
    "THIRD_PARTY_LICENSES"
  ],
  "preferUnplugged": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "peerDependencies": {
    "nx": ">=24.0.0 <25"
  },
  "peerDependenciesMeta": {
    "nx": {
      "optional": true
    }
  },
  "dependencies": {
    "@nx/devkit": "24.0.5",
    "cross-spawn": "7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "nx": "24.0.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
